{
  "name": "trail-party",
  "version": "0.0.0",
  "private": true,
  "description": "TrailBase, Svelte and Tauri learning project; shared shell foundation.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "plan:check": "node scripts/plan.mjs check",
    "plan:status": "node scripts/plan.mjs status",
    "test:plan": "node --test scripts/plan.test.mjs",
    "test:scaffold": "node --test scripts/scaffold.test.mjs",
    "dev": "node scripts/dev.mjs",
    "test:bootstrap": "node --test --test-timeout=60000 scripts/bootstrap.test.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "build": "vite build",
    "test:unit": "vitest run",
    "test:shell": "playwright test --config playwright.shell.config.ts",
    "tauri": "tauri",
    "build:backend:probe": "vite build --config tests/backend/fixture/vite.config.ts && jco componentize .artifacts/p01-t2/component/index.mjs --wit node_modules/trailbase-wasm/wit -o .artifacts/p01-t2/component/probe.wasm",
    "test:backend": "node scripts/test-backend.mjs"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.32.1",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/svelte": "1.44.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.20.2",
    "clsx": "2.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "shadcn-svelte": "1.6.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "trailbase-wasm": "0.6.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "mode-watcher": "1.1.0",
    "trailbase": "0.14.1"
  }
}
